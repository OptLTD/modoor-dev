# Modoor env — copy to .env for local use
MODOOR_API_KEY=dev-key-change-me
# id|name (creates tenant+head team+admin on first boot; skips if tenant exists)
# or plain name for auto id: MODOOR_TENANT=demo
# Quote values containing | so `source .env` in make/scripts is safe.
MODOOR_TENANT="1000|demo"
# username|password (or legacy MODOOR_ADMIN_USERNAME / MODOOR_ADMIN_PASSWORD)
MODOOR_ADMIN="superuser|pass@word"
# Optional int overrides after bootstrap (defaults: admin user / root team)
# MODOOR_USER_ID=1
# MODOOR_TEAM_ID=1
MODOOR_CONFIRM_SECRET=dev-confirm-secret-change-me
MODOOR_CONFIRM_TTL_SECONDS=600

# Existing local Postgres (user/password/db must already exist).
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/modoor

# Repo roots (optional; auto-detected)
# MODOOR_PLATFORM_ROOT=   # builtin modules dir (base/doc/wiki/skill)
# Default: ./addon (sale demo). Override to mount an external addon tree:
# MODOOR_ADDON_ROOT=/path/to/external/addon



# Console / listen URL. Module Vite ports: id=port (host from WEBUI_URL).
MODOOR_WEBUI_URL=http://127.0.0.1:8765
MODOOR_MODULE_URLS=base=5175,wiki=5176,sale=5177,skill=5178,doc=5179,fleet=5180,freight=5181,capacity=5182,dispatch=5183
# Preview: comma module ids to mount dist (empty = all with dist). Dev uses MODOOR_WEBUI_PROXIES instead.
# MODOOR_WEBUI_STATIC_MODULES=base,wiki,sale,skill,doc,fleet,freight,capacity,dispatch
# 天地图：浏览器端 Key 绑域名（底图瓦片）；服务端 Key 绑服务器出口 IP（驾车规划）
# https://console.tianditu.gov.cn/
# TIANDITU_TK=
# TIANDITU_SERVER_TK=
# MODOOR_WEBUI_PROXIES=

# Blobs: local | aliyun-oss. A copy is always written under STORAGE_ROOT for
# local parsing. With aliyun-oss that copy is a cache and can be deleted after upload.
MODOOR_STORAGE_TYPE=local
MODOOR_STORAGE_ROOT=./storage/doc
# MODOOR_STORAGE_TYPE=aliyun-oss
# MODOOR_ALIYUN_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# MODOOR_ALIYUN_OSS_BUCKET=
# MODOOR_ALIYUN_OSS_AK_ID=
# MODOOR_ALIYUN_OSS_AK_SECRET=
# MODOOR_ALIYUN_OSS_PREFIX=doc/
# OCR + extract run on the job queue (API 默认进程内 worker；也可用 make worker)
# MODOOR_JOBS_INPROCESS=true
# MODOOR_JOBS_POLL_SECONDS=0.5
# 镜像不带 Office / OCR 包。docx、pptx、xlsx 在第一次抽取或表格预览时装进 MODOOR_PY_CACHE。
# 挂卷后重建容器不用重新下载：-v modoor-py:/var/cache/modoor/py
# MODOOR_PY_CACHE=/var/cache/modoor/py
# 镜像默认不装 OCR。MODOOR_DOC_OCR=1 时，启动再把 Tesseract、pypdfium2、Pillow 装进同一个缓存目录。
# 更高要求把 MODOOR_OCR_BACKEND 设为 external，并把图片 POST 到 MODOOR_OCR_URL。
# MODOOR_DOC_OCR=1
# MODOOR_OCR_BACKEND=tesseract
# MODOOR_OCR_LANG=chi_sim+eng
# MODOOR_OCR_URL=https://ocr.example/recognize
# MODOOR_DOC_OCR_MAX_PAGES=20
# MODOOR_DOC_S3_ENDPOINT=
# MODOOR_DOC_S3_BUCKET=
# MODOOR_DOC_S3_ACCESS_KEY=
# MODOOR_DOC_S3_SECRET_KEY=
# MODOOR_DOC_S3_REGION=
# MODOOR_DOC_S3_PREFIX=doc/

MODOOR_SESSION_SECRET=dev-session-secret-change-me

# Login captcha. Empty MODOOR_NOTIFY keeps the dev echo (see MODOOR_CAPTCHA_ECHO).
# MODOOR_NOTIFY=aliyun-sms
# MODOOR_CAPTCHA_ECHO=0
# MODOOR_SMTP_HOST=smtp.example.com
# MODOOR_SMTP_PORT=587
# MODOOR_SMTP_USER=
# MODOOR_SMTP_PASS=
# MODOOR_SMTP_FROM=noreply@example.com
# MODOOR_SMTP_TLS=1
# MODOOR_ALIYUN_SMS_AK_ID=
# MODOOR_ALIYUN_SMS_AK_SECRET=
# MODOOR_ALIYUN_SMS_SIGN=
# MODOOR_ALIYUN_SMS_TEMPLATE=SMS_000000

# External apps → Modoor registry
# MODOOR_URL=http://127.0.0.1:8765
# EXTERNAL_BOARD_PORT=8771
# EXTERNAL_PULSE_PORT=8772
