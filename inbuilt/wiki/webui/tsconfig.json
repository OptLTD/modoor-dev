{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@modoor/hooks": ["../../../shared/hooks/src"],
      "@modoor/hooks/*": ["../../../shared/hooks/src/*"],
      "vue": ["../../doc/webui/node_modules/vue"]
    }
  },
  "include": ["src", "../../../shared/hooks/src/**/*.ts"]
}
